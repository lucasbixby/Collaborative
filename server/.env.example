# Copy to .env for local development, or next to docker-compose.yml for Docker.
# All variables are optional.
COLLAB_DATABASE_URL=sqlite+aiosqlite:///./data/collaborative.db
COLLAB_ASSET_DIR=./data/assets
# Leave unset and the server generates a signing key and keeps it in COLLAB_SECRET_KEY_FILE.
# COLLAB_SECRET_KEY=
COLLAB_SECRET_KEY_FILE=./data/secret.key
COLLAB_TOKEN_TTL_HOURS=168
COLLAB_MAX_OPERATION_BYTES=65536
COLLAB_MAX_FILE_BYTES=536870912
COLLAB_SNAPSHOT_EVERY=500
COLLAB_AUTH_ATTEMPTS=10
COLLAB_AUTH_WINDOW_SECONDS=300
